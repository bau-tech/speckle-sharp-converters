<Project>
  <ItemGroup>
    <PackageVersion Include="altcover" Version="9.0.102" />
    <PackageVersion Include="Bullseye" Version="6.1.0" />
    <PackageVersion Include="CefSharp.Wpf" Version="92.0.260" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="AwesomeAssertions" Version="8.1.0" />
    <PackageVersion Include="Glob" Version="1.1.9" />
    <!--
    Grpc.Core/Grpc.Core.Api are pulled in transitively by OpenTelemetry.Exporter.OpenTelemetryProtocol's
    netstandard2.0 dependency group (only needed for the native gRPC OTLP protocol — we only use HttpProtobuf).
    Pinned + excluded below so their assets never reach the output/ILRepack merge: Grpc.Core.Api embeds its
    own PolySharp-generated DynamicallyAccessedMembersAttribute polyfill that collides with another merged
    assembly's copy, causing a duplicate-type BadImageFormatException at init.
    -->
    <PackageVersion Include="Grpc.Core" Version="2.44.0" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.44.0" />
    <PackageVersion Include="ILRepack.FullAuto" Version="1.6.0" />
    <PackageVersion Include="JetBrains.Profiler.SelfApi" Version="2.5.12" />
    <PackageVersion Include="LibTessDotNet" Version="1.1.15" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Moq" Version="4.20.70" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Build" Version="18.4.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageVersion Include="Npgsql" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.9" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.1938.49" />
    <PackageVersion Include="NUnit" Version="4.5.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.12.0" />
    <PackageVersion Include="NUnit3TestAdapter" version="6.2.0" />
    <PackageVersion Include="Revit.Async" Version="2.1.1" />
    <PackageVersion Include="Semver" Version="3.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Speckle.DoubleNumerics" Version="4.1.0" />
    <PackageVersion Include="Speckle.Triangle" Version="1.0.0" />
    <PackageVersion Include="System.Resources.Extensions" Version="9.0.4" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageVersion Include="Tekla.Structures.Catalogs" Version="2024.0.4" />
    <PackageVersion Include="Tekla.Structures.Dialog" Version="2024.0.4" PrivateAssets="all" IncludeAssets="compile; build" />
    <PackageVersion Include="Tekla.Structures.Drawing" Version="2024.0.4" />
    <PackageVersion Include="Tekla.Structures.Model" Version="2024.0.4" />
    <PackageVersion Include="Tekla.Structures.Plugins" Version="2024.0.4" PrivateAssets="all" IncludeAssets="compile; build" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.11.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" version="1.11.0" />
    <PackageVersion Include="Serilog" Version="4.0.1" />
    <PackageVersion Include="System.Text.Json" Version="5.0.2" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Speckle.Revit.API" Version="2023.0.0" />
    <PackageVersion Include="Speckle.Objects" Version="3.20.6" />
    <PackageVersion Include="SimpleExec" Version="12.0.0" />
    <GlobalPackageReference Include="PolySharp" Version="1.15.0" />
    <GlobalPackageReference Include="Speckle.InterfaceGenerator" Version="0.9.6" />
    <!-- allows for non-windows platforms to target net48 without error -->
    <GlobalPackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>
</Project>
