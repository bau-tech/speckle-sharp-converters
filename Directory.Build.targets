<Project>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' or '$(TestProjectAnalyserRules)' == 'true' ">
    <NoWarn>
      <!-- Things we need to test -->
      CS0618;CA1034;CA2201;CA1051;CA1040;CA1724;CA1065;
      IDE0044;IDE0130;CA1508;
      <!-- Analysers that provide no tangeable value to a test project -->
      CA5394;CA2007;CA1852;CA1819;CA1711;CA1063;CA2234;CA1054;CA1810;CA2208;CA1019;CA1831;CA1515;
      <!-- Analysers that introduce too much friction for a test project -->
      CA2263;
      $(NoWarn);
    </NoWarn>
  </PropertyGroup>

  <!-- ILRepack.FullAuto rewrites the compiled assembly in obj/ in place. On an incremental build
       where CoreCompile is skipped, the copy-local step restores the dependency DLLs to bin/ and
       the merge runs again over the already-merged obj assembly, duplicating every internalized
       type (BadImageFormatException at runtime). Deleting the intermediate assembly up front
       forces a fresh compile in the projects that opt into merging, making the merge idempotent. -->
  <Target
    Name="_ILRepackForceFreshCompile"
    BeforeTargets="CoreCompile"
    Condition="'$(ILRepackBuildEnable)' != 'false' AND '$(ILRepackTargetConfigurations)' != '' AND '@(IntermediateAssembly)' != ''"
  >
    <Delete Files="@(IntermediateAssembly)" />
  </Target>
</Project>
