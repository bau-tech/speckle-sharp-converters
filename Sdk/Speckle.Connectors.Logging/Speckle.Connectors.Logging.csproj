<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Configurations>Debug;Release;Local</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <PolySharpExcludeGeneratedTypes>System.Range;System.Index</PolySharpExcludeGeneratedTypes>
    <ILRepackTargetConfigurations>Debug;Release;Local</ILRepackTargetConfigurations>
    <ILRepackRenameInternalized>true</ILRepackRenameInternalized>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ILRepack.FullAuto">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
    OpenTelemetry.Exporter.OpenTelemetryProtocol 1.13.x has two CVEs. The impact on us is minimal since they allow DOS
    only if our collector to be compromosed or through MitM.
    Pinned back to 1.11.1: 1.13.x introduces transitive deps that ILRepack duplicates via two dependency paths,
    causing BadImageFormatException on .NET 4.8 (duplicate IAsyncDisposable type).
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g94r-2vxg-569j" NoWarn="NU1903" />
    <!-- Neuter the netstandard2.0 transitive Grpc.Core/Grpc.Core.Api deps of the OTLP exporter (see comment
         on the PackageVersion entries in Directory.Packages.props for why) — ExcludeAssets="all" satisfies
         the version constraint without copying their assemblies into the output/merge. -->
    <PackageReference Include="Grpc.Core" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Grpc.Core.Api" PrivateAssets="all" ExcludeAssets="all" />
    <!--
    NOTE: Microsoft.Bcl.AsyncInterfaces is also merged/internalized into this assembly (along with
    Microsoft.Extensions.DependencyInjection's ServiceProvider, which implements it) - deliberately
    NOT excluded here. Unlike Speckle.Sdk.Dependencies (whose IAsyncDisposable-implementing types
    interoperate with external, non-merged code), this assembly's DI/logging setup is self-contained:
    both the interface and its implementer are merged together consistently. Excluding just the
    interface while still merging ServiceProvider broke ILRepack's explicit-interface-implementation
    wiring (TypeLoadException: DisposeAsync has no implementation) - partial exclusion is worse than
    the original cross-assembly mismatch this was meant to fix.
    -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" PrivateAssets="contentfiles;build;analyzers;buildtransitive" NoWarn="NU1902" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" PrivateAssets="contentfiles;build;analyzers;buildtransitive" />
    <PackageReference Include="Serilog" PrivateAssets="contentfiles;build;analyzers;buildtransitive" />
    <PackageReference Include="Serilog.Exceptions" PrivateAssets="contentfiles;build;analyzers;buildtransitive" />
    <PackageReference Include="Serilog.Extensions.Logging" PrivateAssets="contentfiles;build;analyzers;buildtransitive" />
    <PackageReference Include="Serilog.Sinks.Console" PrivateAssets="contentfiles;build;analyzers;buildtransitive" />
    <PackageReference Include="Serilog.Sinks.File" PrivateAssets="contentfiles;build;analyzers;buildtransitive" />
  </ItemGroup>
</Project>
