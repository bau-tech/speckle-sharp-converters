#3037=IFCGRIDAXIS('A',#3036,.T.);
#3038=IFCGRID('bWrzGm1SD2ev45B_OWQ39K',#18,'Test Grid',$,$,#101,$,(#3033),(#3037),$,$);
#3040=IFCCARTESIANPOINT((100.,200.,300.));
#3041=IFCVERTEXPOINT(#3040);
#3042=IFCCARTESIANPOINT((400.,500.,100.));
#3043=IFCVERTEXPOINT(#3042);
#3047=IFCLINE(#3040,#3046);
#3046=IFCVECTOR(#3045,1.);
#3045=IFCDIRECTION((0.,0.,1.));
#3048=IFCEDGECURVE(#3041,#3043,#3047,.T.);
#3049=IFCORIENTEDEDGE(*,*,#3048,.T.);
#3050=IFCEDGELOOP((#3049));
#3051=IFCFACEOUTERBOUND(#3050,.T.);
#3052=IFCPLANE(#67);
#3053=IFCADVANCEDFACE((#3051),#3052,.T.);
#3054=IFCCLOSEDSHELL((#3053));
#3055=IFCADVANCEDBREP(#3054);
#3056=IFCSHAPEREPRESENTATION(#26,'Body','AdvancedBrep',(#3055));
#3057=IFCPRODUCTDEFINITIONSHAPE($,$,(#3056));
#3058=IFCBUILDINGELEMENTPROXY('cWrzGm1SD2ev45B_OWQ39L',#18,'Test Brep Element',$,'Test Brep Element',#101,#3057,'124568',$);
#3080=IFCCARTESIANPOINTLIST2D(((0.,0.),(500.,0.),(500.,400.),(470.71068,470.71068),(400.,500.),(0.,500.)));
#3081=IFCINDEXEDPOLYCURVE(#3080,(IFCLINEINDEX((1,2,3)),IFCARCINDEX((3,4,5)),IFCLINEINDEX((5,6,1))),$);
#3082=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'TestRoundedProfile',#3081);
#3090=IFCCARTESIANPOINT((0.,-80.,-1800.));
#3091=IFCCARTESIANPOINT((6000.,-80.,-1800.));
#3092=IFCCARTESIANPOINT((6000.,80.,-1800.));
