ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('minimal-sample.ifc','2026-07-20T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#18=IFCOWNERHISTORY($,$,$,.NOCHANGE.,$,$,$,1780627661);

/* -- Representation contexts, referenced by every IfcShapeRepresentation below - content unused. -- */
#25=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Axis','Model',*,*,*,*,#20,$,.MODEL_VIEW.,$);
#26=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#20,$,.MODEL_VIEW.,$);
#28=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('FootPrint','Model',*,*,*,*,#20,$,.MODEL_VIEW.,$);
#20=IFCCARTESIANPOINT((0.,0.,0.));

/* -- Identity placement, used where placement isn't the point under test -- */
#3=IFCCARTESIANPOINT((0.,0.,0.));
#100=IFCAXIS2PLACEMENT3D(#3,$,$);
#101=IFCLOCALPLACEMENT($,#100);

/* -- Wall, with an Axis representation (mirrors the real file's walls) and a "Clipping"-wrapped Body
   (mirrors the real file's wall bodies exactly: IfcBooleanClippingResult(.DIFFERENCE., baseExtrusion,
   clippingHalfSpace), where the base extrusion's own Depth (3600mm here) is the wall's real,
   pre-clip height) - regression coverage for TryResolveBodyExtrusionDepth unwrapping this instead of
   falling back to the hardcoded default. -- */
#4=IFCCARTESIANPOINT((0.,0.));
#2444=IFCCARTESIANPOINT((8175.,0.));
#2445=IFCPOLYLINE((#4,#2444));
#2446=IFCSHAPEREPRESENTATION(#25,'Axis','Curve2D',(#2445));
#3000=IFCCARTESIANPOINT((0.,0.));
#3001=IFCAXIS2PLACEMENT2D(#3000,$);
#3002=IFCRECTANGLEPROFILEDEF(.AREA.,$,#3001,8175.,300.);
#3003=IFCAXIS2PLACEMENT3D(#3,$,$);
#3004=IFCEXTRUDEDAREASOLID(#3002,#3003,#9,3600.);
#3005=IFCAXIS2PLACEMENT3D(#3,#9,$);
#3006=IFCPLANE(#3005);
#3007=IFCHALFSPACESOLID(#3006,.F.);
#3008=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#3004,#3007);
#3009=IFCSHAPEREPRESENTATION(#26,'Body','Clipping',(#3008));
#2447=IFCPRODUCTDEFINITIONSHAPE($,$,(#2446,#3009));
#2467=IFCWALL('01SfNHv5nEReC9M9Bzo7D_',#18,'Basiswand:Exterior - 300mm Concrete:123276',$,'Basiswand:Exterior - 300mm Concrete',#101,#2447,'123276',.NOTDEFINED.);

/* -- Round column, real structure copied from rstadvancedsampleproject.ifc: MappedRepresentation
   indirection (IfcMappedItem -> IfcRepresentationMap -> the actual SweptSolid) -- */
#64=IFCCARTESIANPOINT((0.,0.));
#65=IFCCIRCLEPROFILEDEF(.AREA.,'450mm',#64,224.99999999999562);
#67=IFCAXIS2PLACEMENT3D(#3,$,$);
#9=IFCDIRECTION((0.,0.,1.));
#68=IFCEXTRUDEDAREASOLID(#65,#67,#9,3500.0000000011578);
#77=IFCSHAPEREPRESENTATION(#26,'Body','SweptSolid',(#68));
#78=IFCAXIS2PLACEMENT3D(#3,$,$);
#79=IFCREPRESENTATIONMAP(#78,#77);
#162=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#3,$,$);
#163=IFCMAPPEDITEM(#79,#162);
#164=IFCSHAPEREPRESENTATION(#26,'Body','MappedRepresentation',(#163));
#165=IFCPRODUCTDEFINITIONSHAPE($,$,(#164));

/* -- Rotated placement chain, synthetic (the real file had none - see plan's live-file findings):
   parent placed at (100,200,0) with local X rotated to point along world Y; child placed 10mm along
   its own (rotated) local X. Hand-computed expected absolute: origin=(100,210,0),
   XAxis=(0,1,0), YAxis=(-1,0,0), ZAxis=(0,0,1). -- */
#200=IFCDIRECTION((0.,0.,1.));
#201=IFCDIRECTION((0.,1.,0.));
#202=IFCCARTESIANPOINT((100.,200.,0.));
#203=IFCAXIS2PLACEMENT3D(#202,#200,#201);
#204=IFCLOCALPLACEMENT($,#203);
#210=IFCCARTESIANPOINT((10.,0.,0.));
#211=IFCAXIS2PLACEMENT3D(#210,$,$);
#167=IFCLOCALPLACEMENT(#204,#211);

#168=IFCCOLUMN('18YHwga450Mw4Fy6M5t_BM',#18,'M_Concrete-Round-Column:450mm:122477',$,'M_Concrete-Round-Column:450mm',#167,#165,'122477',.COLUMN.);

/* -- Rectangular-profile element, direct SweptSolid (no Mapped indirection) - a beam-shaped element
   with a clean extrusion, to test the rectangular profile path. -- */
#500=IFCCARTESIANPOINT((0.,0.));
#501=IFCRECTANGLEPROFILEDEF(.AREA.,'400 x 800mm',#500,400.,800.);
#502=IFCAXIS2PLACEMENT3D(#3,$,$);
#503=IFCEXTRUDEDAREASOLID(#501,#502,#9,6000.);
#504=IFCSHAPEREPRESENTATION(#26,'Body','SweptSolid',(#503));
#505=IFCPRODUCTDEFINITIONSHAPE($,$,(#504));
#506=IFCBEAM('2WrzGm1SD2ev45B_OWQ39B',#18,'M_Concrete-Rectangular Beam:400 x 800mm:124559',$,'M_Concrete-Rectangular Beam:400 x 800mm',#101,#505,'124559',.BEAM.);

/* -- Non-extrusion body (AdvancedBrep) with a clean Axis anyway - mirrors the real file's beams
   exactly (mitered end cuts break Body, but Axis is unaffected). TryResolveExtrudedProfile must
   gracefully fail on the body while TryExtractAxisLine still succeeds on the axis. -- */
#600=IFCSHAPEREPRESENTATION(#26,'Body','AdvancedBrep',(#601));
#601=IFCCARTESIANPOINT((0.,0.,0.));
#610=IFCCARTESIANPOINT((0.,0.,3000.));
#611=IFCCARTESIANPOINT((5000.,0.,3000.));
#612=IFCPOLYLINE((#610,#611));
#613=IFCSHAPEREPRESENTATION(#25,'Axis','Curve3D',(#612));
#602=IFCPRODUCTDEFINITIONSHAPE($,$,(#600,#613));
#603=IFCBEAM('3WrzGm1SD2ev45B_OWQ39C',#18,'M_Concrete-Rectangular Beam:400 x 800mm:124560',$,'M_Concrete-Rectangular Beam:400 x 800mm',#101,#602,'124560',.BEAM.);

/* -- Straight beam whose Axis is an IfcTrimmedCurve over an IfcLine (mirrors the real file's beam
   #2935 exactly - the .CARTESIAN. trim-point case, only previously covered by the explicit real-file
   test, not this local fixture). -- */
#700=IFCCARTESIANPOINT((0.,0.,0.));
#701=IFCDIRECTION((1.,0.,0.));
#702=IFCVECTOR(#701,1.);
#703=IFCLINE(#700,#702);
#710=IFCCARTESIANPOINT((0.,0.,4000.));
#711=IFCCARTESIANPOINT((3000.,0.,4000.));
#712=IFCTRIMMEDCURVE(#703,(#710),(#711),.T.,.CARTESIAN.);
#713=IFCSHAPEREPRESENTATION(#25,'Axis','Curve3D',(#712));
#714=IFCPRODUCTDEFINITIONSHAPE($,$,(#713));
#715=IFCBEAM('4WrzGm1SD2ev45B_OWQ39D',#18,'Straight Trimmed Beam',$,'Straight Trimmed Beam',#101,#714,'124561',.BEAM.);

/* -- Curved beam whose Axis is an IfcTrimmedCurve over an IfcCircle - regression fixture for a bug
   found from a live receive: the two .CARTESIAN. trim points are only the chord endpoints of the
   arc, not a straight segment. TryExtractAxisLine must bail out (false), not silently return the
   chord as if it were a straight beam. -- */
#720=IFCAXIS2PLACEMENT3D(#3,$,$);
#721=IFCCIRCLE(#720,2000.);
#730=IFCCARTESIANPOINT((2000.,0.,0.));
#731=IFCCARTESIANPOINT((0.,2000.,0.));
#732=IFCTRIMMEDCURVE(#721,(#730),(#731),.T.,.CARTESIAN.);
#733=IFCSHAPEREPRESENTATION(#25,'Axis','Curve3D',(#732));
#734=IFCPRODUCTDEFINITIONSHAPE($,$,(#733));
#735=IFCBEAM('5WrzGm1SD2ev45B_OWQ39E',#18,'Curved Beam',$,'Curved Beam',#101,#734,'124562',.BEAM.);

#81=IFCMATERIAL('Concrete - Cast-in-Place Concrete - 28 MPa',$,'Concrete');

/* -- Material associations, real structure copied from rstadvancedsampleproject.ifc:
   IfcRelAssociatesMaterial(...,RelatedObjects,RelatingMaterial) is an INVERSE relationship (lists the
   elements it relates to), unlike every other reference in this file - see
   IfcMaterialThicknessExtractor's remarks. -- */
/* Wall #2467: single 300mm layer, matching its own "300mm Concrete" name. */
#2478=IFCMATERIALLAYER(#81,300.,$,'Concrete',$,$,$);
#2479=IFCMATERIALLAYERSET((#2478),'Exterior - 300mm Concrete',$);
#2480=IFCMATERIALLAYERSETUSAGE(#2479,.AXIS2.,.NEGATIVE.,150.,$);
#106672=IFCRELASSOCIATESMATERIAL('0VkfsXHFj22TPWFta6sWRg',#18,$,$,(#2467),#2480);
/* Column #168: associated directly with the plain IfcMaterial (no layers) - mirrors the real column's
   actual association exactly (confirmed: no IfcMaterialProfileSet, just a bare material) - regression
   coverage for TryGetLayerSetThicknessMm correctly rejecting this rather than guessing a thickness. */
#106674=IFCRELASSOCIATESMATERIAL('1WrzGm1SD2ev45B_OWQ3XX',#18,$,$,(#168),#81);

/* -- Floor/slab with a FootPrint boundary (4-segment closed rectangle, mirrors the real file's
   IfcCompositeCurve-of-2-point-IfcPolyline-segments structure) and its own 200mm material layer. -- */
#900=IFCCARTESIANPOINT((0.,0.));
#901=IFCCARTESIANPOINT((5000.,0.));
#902=IFCCARTESIANPOINT((5000.,4000.));
#903=IFCCARTESIANPOINT((0.,4000.));
#910=IFCPOLYLINE((#900,#901));
#911=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#910);
#912=IFCPOLYLINE((#901,#902));
#913=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#912);
#914=IFCPOLYLINE((#902,#903));
#915=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#914);
#916=IFCPOLYLINE((#903,#900));
#917=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#916);
#920=IFCCOMPOSITECURVE((#911,#913,#915,#917),.F.);
#921=IFCSHAPEREPRESENTATION(#28,'FootPrint','Curve2D',(#920));
#922=IFCPRODUCTDEFINITIONSHAPE($,$,(#921));
#930=IFCSLAB('6WrzGm1SD2ev45B_OWQ39F',#18,'Floor:Generic 200mm:124563',$,'Floor:Generic 200mm',#101,#922,'124563',.FLOOR.);

#940=IFCMATERIALLAYER(#81,200.,$,'Concrete',$,$,$);
#941=IFCMATERIALLAYERSET((#940),'Generic 200mm',$);
#942=IFCMATERIALLAYERSETUSAGE(#941,.AXIS3.,.POSITIVE.,0.,$);
#106673=IFCRELASSOCIATESMATERIAL('3alvS4usExYmuogZiLnjW6',#18,$,$,(#930),#942);

/* -- Second floor/slab whose FootPrint is a bare closed IfcPolyline directly (no IfcCompositeCurve
   wrapper) - mirrors the real file's more common case (3 of 5 slabs use this simpler form; only
   found from a live receive, not assumed from the first sample checked), including the real file's
   convention of repeating the first point as the last to close the loop. -- */
#950=IFCCARTESIANPOINT((0.,0.));
#951=IFCCARTESIANPOINT((6000.,0.));
#952=IFCCARTESIANPOINT((6000.,3000.));
#953=IFCCARTESIANPOINT((0.,3000.));
#954=IFCPOLYLINE((#950,#951,#952,#953,#950));
#955=IFCSHAPEREPRESENTATION(#28,'FootPrint','Curve2D',(#954));
#956=IFCPRODUCTDEFINITIONSHAPE($,$,(#955));
#957=IFCSLAB('7WrzGm1SD2ev45B_OWQ39G',#18,'Floor:Generic 200mm:124564',$,'Floor:Generic 200mm',#101,#956,'124564',.FLOOR.);

/* -- Opening hosted on floor #930, mirroring the real file's opening structure: rectangular
   SweptSolid body whose profile has its own non-identity Position (offset AND rotated) - regression
   coverage for the full element-placement -> extrusion-Position -> profile-Position composition
   chain (confirmed necessary from a live receive - a real opening's profile Position was offset and
   rotated, not identity like every other profile checked before it). -- */
#960=IFCCARTESIANPOINT((1000.,500.));
#961=IFCDIRECTION((0.,1.));
#962=IFCAXIS2PLACEMENT2D(#960,#961);
#963=IFCRECTANGLEPROFILEDEF(.AREA.,$,#962,400.,200.);
#964=IFCAXIS2PLACEMENT3D(#3,$,$);
#965=IFCEXTRUDEDAREASOLID(#963,#964,#9,300.);
#966=IFCSHAPEREPRESENTATION(#26,'Body','SweptSolid',(#965));
#967=IFCPRODUCTDEFINITIONSHAPE($,$,(#966));
#968=IFCOPENINGELEMENT('8WrzGm1SD2ev45B_OWQ39H',#18,'Opening',$,$,#101,#967,'124565',.OPENING.);
#106675=IFCRELVOIDSELEMENT('2WrzGm1SD2ev45B_OWQ3YY',#18,$,$,#930,#968);

/* -- Round floor whose FootPrint is a full circle built from 4 quarter-arc IfcTrimmedCurve segments
   (.PARAMETER. trim, degrees - this project's plane angle unit, confirmed via a live receive's
   IfcUnitAssignment/IfcConversionBasedUnit check) - regression coverage for tessellating a curved
   composite-curve segment into a chord-approximating polyline instead of bailing out to DirectShape. -- */
#970=IFCCARTESIANPOINT((0.,0.));
#971=IFCAXIS2PLACEMENT2D(#970,$);
#972=IFCCIRCLE(#971,1000.);
#973=IFCTRIMMEDCURVE(#972,(IFCPARAMETERVALUE(0.)),(IFCPARAMETERVALUE(90.)),.T.,.PARAMETER.);
#974=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#973);
#975=IFCTRIMMEDCURVE(#972,(IFCPARAMETERVALUE(90.)),(IFCPARAMETERVALUE(180.)),.T.,.PARAMETER.);
#976=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#975);
#977=IFCTRIMMEDCURVE(#972,(IFCPARAMETERVALUE(180.)),(IFCPARAMETERVALUE(270.)),.T.,.PARAMETER.);
#978=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#977);
#979=IFCTRIMMEDCURVE(#972,(IFCPARAMETERVALUE(270.)),(IFCPARAMETERVALUE(360.)),.T.,.PARAMETER.);
#980=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#979);
#981=IFCCOMPOSITECURVE((#974,#976,#978,#980),.T.);
#982=IFCSHAPEREPRESENTATION(#28,'FootPrint','Curve2D',(#981));
#983=IFCPRODUCTDEFINITIONSHAPE($,$,(#982));
#984=IFCSLAB('9WrzGm1SD2ev45B_OWQ39I',#18,'Round Floor',$,'Round Floor',#101,#983,'124566',.FLOOR.);

/* -- Isolated pad footing (SweptSolid + IfcRectangleProfileDef, mirroring the same well-tested
   column extraction shape) - UNVERIFIED against real data (this feature's real test file has zero
   IfcFooting entities at all), so this fixture is the only regression coverage for it. -- */
#3020=IFCCARTESIANPOINT((0.,0.));
#3021=IFCAXIS2PLACEMENT2D(#3020,$);
#3022=IFCRECTANGLEPROFILEDEF(.AREA.,$,#3021,1500.,1200.);
