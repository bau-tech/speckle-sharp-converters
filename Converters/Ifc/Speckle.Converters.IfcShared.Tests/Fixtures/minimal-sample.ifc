#3025=IFCEXTRUDEDAREASOLID(#3022,#3024,#9,800.);
#3026=IFCSHAPEREPRESENTATION(#26,'Body','SweptSolid',(#3025));
#3027=IFCPRODUCTDEFINITIONSHAPE($,$,(#3026));
#3028=IFCFOOTING('aWrzGm1SD2ev45B_OWQ39J',#18,'Pad Footing 1500x1200',$,'Pad Footing 1500x1200',#101,#3027,'124567',.PAD_FOOTING.);
#3030=IFCCARTESIANPOINT((0.,0.,0.));
#3031=IFCCARTESIANPOINT((1000.,0.,0.));
#3032=IFCPOLYLINE((#3030,#3031));
#3033=IFCGRIDAXIS('1',#3032,.T.);
#3034=IFCCARTESIANPOINT((0.,0.,0.));
#3035=IFCCARTESIANPOINT((0.,2000.,0.));
