#3130=IFCCARTESIANPOINTLIST2D(((0.,0.),(2000.,0.),(2000.,3000.),(0.,3000.),(0.,0.)));
#3131=IFCPOLYLINE((#3132,#3133,#3134,#3135,#3132));
#3132=IFCCARTESIANPOINT((0.,0.));
#3133=IFCCARTESIANPOINT((2000.,0.));
